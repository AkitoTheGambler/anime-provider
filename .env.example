# Server
PORT=3000
NODE_ENV=development

# Provider
PROVIDER_IDENTIFIER=tv.plex.agents.custom.anime
PROVIDER_TITLE=Anime
PROVIDER_VERSION=1.0.0
# empty = http://localhost:PORT
PROVIDER_URL=

# Metadata source
# jikan | mal | anidb
METADATA_SOURCE=jikan

# Jikan
JIKAN_BASE_URL=https://api.jikan.moe/v4
JIKAN_RATE_LIMIT_PER_SECOND=3
JIKAN_RATE_LIMIT_PER_MINUTE=60
JIKAN_TIMEOUT_MS=20000
JIKAN_RETRIES=3

# MyAnimeList API v2
MAL_CLIENT_ID=
MAL_API_BASE_URL=https://api.myanimelist.net/v2
MAL_REQUESTS_PER_SECOND=2

# AniDB
ANIDB_CLIENT=
ANIDB_CLIENT_VERSION=
ANIDB_API_URL=http://api.anidb.net:9001/httpapi
ANIDB_TITLES_URL=https://anidb.net/api/anime-titles.xml.gz
ANIDB_IMAGE_BASE_URL=https://cdn-eu.anidb.net/images/main
ANIDB_CACHE_DIR=./cache/anidb
ANIDB_CACHE_HOURS=24
ANIDB_TITLES_REFRESH_HOURS=24
ANIDB_REQUEST_INTERVAL_MS=2500
ANIDB_MIN_TAG_WEIGHT=300

# Matching
MATCH_SCORING=false

# Collections
COLLECTIONS=true
# true | false
LISTS_DOWNLOAD=true

# Plex
PLEX_URL=http://localhost:32400
PLEX_TOKEN=
PLEX_LIBRARY=Anime
COLLECTION_SYNC_HOURS=6

# Cache
CACHE_ANIME_DETAILS_HOURS=24
CACHE_EPISODES_HOURS=12
CACHE_SEARCH_HOURS=1
CACHE_CHARACTERS_DAYS=7

# Preferences
# english | romaji | japanese | german | french | spanish
TITLE_LANGUAGE=english
