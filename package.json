{
  "name": "anime-metadata-provider",
  "version": "1.0.0",
  "description": "Anime Metadata Provider: Plex metadata provider for anime (MyAnimeList via Jikan or the MAL API, AniDB)",
  "main": "dist/server.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "ts-node src/server.ts",
    "dev": "ts-node src/server.ts",
    "lint": "eslint src/**/*.ts",
    "sync-collections": "node dist/tools/syncCollections.js",
    "franchise": "node dist/tools/franchise.js"
  },
  "keywords": [
    "plex",
    "metadata",
    "provider",
    "anime",
    "myanimelist",
    "mal",
    "jikan"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.12.2",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.11.2",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/winston": "^2.4.4",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
